# ═══════════════════════════════════════════════════════
# SCHEME FINDER — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=development
PORT=5050

# ── MongoDB (Stage 2) ──
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/scheme-finder?retryWrites=true&w=majority

# ── JWT Auth (Stage 2) ──
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ──
ALLOWED_ORIGIN=http://localhost:3000

# ── OpenRouter (AI explanation + NL profile parsing — phrasing/extraction only, never eligibility) ──
OPEN_ROUTER=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ── Nodemailer SMTP proposal emails (backend only) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address approved by your email provider. Defaults to SMTP_USER if it is an email address.
SMTP_FROM=
# Optional: true for implicit TLS (normally 465); false for STARTTLS (normally 587).
# SMTP_SECURE=false

# Comma-separated account emails authorised to review source proposals. Empty denies all.
SCHEME_REVIEWER_EMAILS=

# Enable the persisted human-review queue daily at 03:00 IST.
INGESTION_ENABLED=false
